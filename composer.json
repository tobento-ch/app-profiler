{
    "name": "tobento/app-profiler",
    "version": "2.0",
    "type": "library",
    "description": "App profiler.",
    "keywords": [
        "tobento",
        "package",
        "app",
        "profiler",
        "tests"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/app": "^2.0",
        "tobento/app-migration": "^2.0",
        "tobento/app-http": "^2.0",
        "tobento/app-view": "^2.0",
        "tobento/service-collection": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "symfony/var-dumper": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "tobento/app-testing": "^2.0",
        "tobento/app-translation": "^2.0",
        "tobento/app-database": "^2.0",
        "tobento/app-user": "^2.0",
        "tobento/app-console": "^2.0",
        "tobento/app-event": "^2.0",
        "tobento/app-queue": "^2.0",
        "tobento/app-logging": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\Profiler\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Profiler\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}
